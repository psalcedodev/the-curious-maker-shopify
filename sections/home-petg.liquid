{{ 'section-home-petg.css' | asset_url | stylesheet_tag }}
<script src="{{ 'home-scroll-reveal.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section
  class="home-petg section-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
  id="home-petg-{{ section.id }}"
>
  <div class="page-width">
    <div class="home-petg__content reveal{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {%- if section.settings.label != blank -%}
        <span class="home-petg__label">{{ section.settings.label | escape }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="home-petg__heading">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}

      <div class="home-petg__rule"> </div>

      {%- if section.settings.description != blank -%}
        <p class="home-petg__description">
          {{ section.settings.description | escape }}
        </p>
      {%- endif -%}
    </div>

    <div class="home-petg__gallery reveal{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" style="transition-delay: 150ms;">
      <figure class="home-petg__figure">
        {%- if section.settings.image_1 != blank -%}
          {{
            section.settings.image_1
            | image_url: width: 1600
            | image_tag:
              loading: 'lazy',
              alt: section.settings.image_1.alt | default: 'Two identical printed cups after time in the sun. The PETG cup on the left holds its straight shape. The PLA cup on the right has warped and creased.',
              sizes: '(min-width: 750px) 45vw, 90vw',
              widths: '375, 550, 750, 1100, 1600'
          }}
        {%- else -%}
          <img
            src="{{ 'petg-same-sun-different-material.jpg' | asset_url }}"
            loading="lazy"
            alt="Two identical printed cups after time in the sun. The PETG cup on the left holds its straight shape. The PLA cup on the right has warped and creased."
            width="1800"
            height="1350"
          >
        {%- endif -%}
      </figure>

      <figure class="home-petg__figure">
        {%- if section.settings.image_2 != blank -%}
          {{
            section.settings.image_2
            | image_url: width: 1600
            | image_tag:
              loading: 'lazy',
              alt: section.settings.image_2.alt | default: 'Comparison table of PETG against PLA for desert sun exposure, rain and sprinklers, summer heat at 114 degrees Fahrenheit, and being left outside for seasons. PETG holds up in every row.',
              sizes: '(min-width: 750px) 45vw, 90vw',
              widths: '375, 550, 750, 1100, 1600'
          }}
        {%- else -%}
          <img
            src="{{ 'petg-114f-comparison-table.jpg' | asset_url }}"
            loading="lazy"
            alt="Comparison table of PETG against PLA for desert sun exposure, rain and sprinklers, summer heat at 114 degrees Fahrenheit, and being left outside for seasons. PETG holds up in every row."
            width="1800"
            height="1350"
          >
        {%- endif -%}
      </figure>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home PETG Story",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section label",
      "info": "Optional eyebrow text above the heading."
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Why we print in PETG</p>"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "We left our parts in a hot car at 114F. They kept their shape. PETG is a filament made for sun, heat, and real use, so that is what we print with."
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1",
      "info": "Defaults to the Same Sun Different Material comparison photo when left empty."
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2",
      "info": "Defaults to the 114F PETG vs PLA comparison table when left empty."
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Home PETG Story"
    }
  ]
}
{% endschema %}
