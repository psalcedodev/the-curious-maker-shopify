{{ 'section-home-proof.css' | asset_url | stylesheet_tag }}
<script src="{{ 'home-scroll-reveal.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- comment -%}
  Blank safe: with zero blocks assigned, the section renders nothing.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <section
    class="home-proof section-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
    id="home-proof-{{ section.id }}"
  >
    <div class="page-width">
      <ul class="home-proof__list reveal{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- for block in section.blocks -%}
          {%- if block.settings.text != blank -%}
            <li class="home-proof__item" {{ block.shopify_attributes }}>
              <span class="home-proof__icon">{% render 'icon-feature', icon_type: 'check' %}</span>
              <span class="home-proof__text">{{ block.settings.text | escape }}</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Home Proof Strip",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "proof_item",
      "name": "Proof item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Proof point"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home Proof Strip",
      "blocks": [
        {
          "type": "proof_item",
          "settings": {
            "text": "Designed in CAD"
          }
        },
        {
          "type": "proof_item",
          "settings": {
            "text": "Printed in PETG"
          }
        },
        {
          "type": "proof_item",
          "settings": {
            "text": "One maker. Six printers."
          }
        }
      ]
    }
  ]
}
{% endschema %}
