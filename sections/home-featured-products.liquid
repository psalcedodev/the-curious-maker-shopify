{{ 'section-home-featured-products.css' | asset_url | stylesheet_tag }}
{{ 'component-home-buttons.css' | asset_url | stylesheet_tag }}
<script src="{{ 'home-scroll-reveal.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign products_to_display = section.settings.collection.all_products_count
  if section.settings.collection.all_products_count > section.settings.products_to_show
    assign products_to_display = section.settings.products_to_show
  endif
-%}

<section
  class="home-featured-products section-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
  id="home-featured-products-{{ section.id }}"
>
  <div class="page-width">
    <div class="home-featured-products__header reveal{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {%- if section.settings.label != blank -%}
        <span class="home-featured-products__label">{{ section.settings.label | escape }}</span>
      {%- endif -%}

      <div class="home-featured-products__header-content">
        <div>
          {%- if section.settings.heading != blank -%}
            <h2 class="home-featured-products__heading">
              {{ section.settings.heading }}
            </h2>
          {%- endif -%}
          <div class="home-featured-products__rule"> </div>
        </div>

        {%- if section.settings.view_all_link != blank -%}
          <a
            href="{{ section.settings.view_all_link }}"
            class="btn-outline home-featured-products__view-all"
          >
            <span>{{ section.settings.view_all_text | default: 'View All Products' | escape }}</span>
            <span class="svg-wrapper">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.collection != blank and section.settings.collection.products.size > 0 -%}
      <div class="home-featured-products__grid">
        {% assign lazy_load = false %}
        {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
          {% if lazy_load == false and forloop.index > 4 %}
            {% assign lazy_load = true %}
          {% endif %}
          {% render 'card-product-home',
            product: product,
            index: forloop.index0,
            lazy_load: lazy_load
          %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="home-featured-products__grid">
        {%- for i in (1..4) -%}
          <div class="home-product-card">
            <div class="home-product-card__image-wrapper">
              {{ 'product-apparel-' | append: i | placeholder_svg_tag: 'home-product-card__image' }}
            </div>
            <div class="home-product-card__info">
              <h3 class="home-product-card__title">Product {{ i }}</h3>
              <div class="home-product-card__footer">
                <span class="home-product-card__price">$99.99</span>
                <a href="#" class="home-product-card__cta">Shop Now</a>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Home Featured Products",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Products to show"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Section label",
      "default": "Our Collection"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Handcrafted Training Aids<br><em>for Serious Golfers</em></p>"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all button text",
      "default": "View All Products"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Home Featured Products"
    }
  ]
}
{% endschema %}
