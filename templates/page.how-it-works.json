          "type": "column",
          "settings": {
            "image": "",
            "title": "Tap",
            "text": "<p>A light tap with a club or your foot triggers the mechanism. No batteries, no motor, no power required.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "step-2": {
          "type": "column",
          "settings": {
            "image": "",
            "title": "Gravity does the work",
            "text": "<p>The hopper holds up to 25 balls. Gravity feeds the next one into position the moment you tap.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "step-3": {
          "type": "column",
          "settings": {
            "image": "",
            "title": "One ball, every time",
            "text": "<p>A single ball drops into place, ready for your next shot, so your practice rhythm does not break.</p>",
            "link_label": "",
            "link": ""
          }
        }
      },
