{% comment %}
  Renders the Primary/Secondary custom color fields for the golf ball
  dispenser. Visible and required ONLY while the variant option named
  "Variation" is set to "Custom"; hidden AND disabled otherwise so nothing
  submits. Values reach the order as line item properties.

  Color list source of truth: Studio vault, projects/shopify/content/product-colors.md
  (canonical 14 filament palette, Bambu PETG HF). Keep the two in sync.

  Accepts:
  - product: {Object} Product Liquid object
  - product_form_id: {String} id of the product form the fields submit with

  Fires `curiousmaker:customcolors` on document with
  {primary, secondary, primaryHex, secondaryHex} on every change, as the
  attach point for a future live preview.

  Usage:
  {% render 'product-custom-colors', product: product, product_form_id: product_form_id %}
{% endcomment %}

{%- if product.handle == 'golf-ball-dispenser-golf-training-aid-for-simulator-backyard-range-practice-25-ball-capacity' -%}
  {%- liquid
    assign variation_index = -1
    for option in product.options_with_values
      if option.name == 'Variation'
        assign variation_index = forloop.index0
      endif
    endfor
    assign set_index = -1
    for option in product.options_with_values
      if option.name == 'Set'
        assign set_index = forloop.index0
      endif
    endfor
    assign current_variation = ''
    if variation_index > -1
      assign current_variation = product.selected_or_first_available_variant.options[variation_index]
    endif
  -%}

  <div
    class="product-custom-colors"
    id="ProductCustomColors-{{ section.id }}"
    data-variation-index="{{ variation_index }}"
    data-set-index="{{ set_index }}"
    data-initial-variation="{{ current_variation | escape }}"
    {%- if set_index > -1 %}
    data-initial-set="{{ product.selected_or_first_available_variant.options[set_index] | escape }}"
    {%- endif %}
    {% unless current_variation == 'Custom' %}
      hidden
    {% endunless %}
  >
    {%- comment -%} Cream removed per Paul 2026-08-18; palette source product-colors.md {%- endcomment -%}
    {%- assign color_names = 'White,Yellow,Orange,Red,Lime Green,Green,Forest Green,Lake Blue,Blue,Peanut Brown,Gray,Dark Gray,Black' | split: ',' -%}
    {%- assign color_hexes = '#FFFFFF,#FFD00B,#F75403,#EB3A3A,#6EE53C,#00AE42,#39541A,#1F79E5,#002E96,#875718,#ADB1B2,#515151,#000000' | split: ',' -%}

    {%- comment -%}
      MEASURED linear albedo per color, parallel to color_names above, entries
      separated by "|" and channels by ",". These are NOT the filament hexes:
      they are the base color factors that make the 3D viewer RENDER the filament
      hex. Swatch dots keep using color_hexes, which stay the true filament hex.

      Derived by measured fixed point iteration against rendered pixels,
      re-solved 2026-08-18 for the linear curve (round 2). Values exceed 1.0 on
      purpose; three.js accepts base color factors above 1 and they are required
      because the curve is applied at a low exposure to suppress the specular
      floor. Single source: Studio vault projects/shopify/content/viewer-cal-REPORT.md

      There are TWO tables because the hopper and funnel catch more light than
      the base and legs, so they clip at a lower albedo. One shared table pushed
      highlight clipping on the hopper to 26.5 percent of its pixels, which
      flattens exactly the part round 2 set out to fix; per role tables hold it
      near 10 percent. Each channel is additionally clamped to a per role
      ceiling, chosen as the albedo where clipping reaches 10 percent. Clamping
      per channel rather than scaling all three uniformly is what keeps Yellow's
      green accurate while only its red is held back.

      Round 3 re-solved these against dispenser-custom-ao.glb, which carries a
      baked AO map. AO multiplies indirect diffuse light, and this scene is lit
      entirely by IBL, so it darkened the sampled band too: the hopper and funnel
      lost about 8 of 255 before the re-solve. The pre AO tables are therefore
      NOT interchangeable with these.

      Round 4 re-solved these again after the mesh changed (smooth normals plus
      per object decimate ratios). More triangles and shared vertex normals move
      the sampled band, so the round 3 tables read up to 19.2 of 255 too bright
      on this geometry. Exposure also dropped 0.17 to 0.15 because the smoother,
      denser Secondary catches more specular, which had pushed its floor, and so
      the error on Black and on zero channels, to 12.1.

      Round 4.3 re-solved these again: the spiral is denser and the occlusion
      strength dropped 0.7 to 0.35, both of which move the sampled band.

      Round 4.2 re-solved these again: the mesh is now flat shaded throughout
      (see product-custom-preview.liquid for why), which moves the sampled band.

      Round 4.1 re-solved these once more: shading is now per role (flat on the
      panels, smooth on the curves), the flat parts take planar dissolve only,
      and occlusionTexture.strength is 0.7, all of which move the sampled band.

      These tables are only valid together with tone-mapping="linear",
      exposure="0.15", shadow-intensity="1.5" and the dispenser-custom-ao.glb
      asset (at occlusion strength 0.7) in
      product-custom-preview.liquid. Change them together.
    {%- endcomment -%}
    {%- assign color_albedos_primary = '6.28790,6.28790,6.28790|6.28790,3.99517,0.01222|5.89174,0.55005,0.00005|5.26604,0.25506,0.25506|0.97787,4.95857,0.27262|0.00000,2.66861,0.33569|0.24697,0.54863,0.05580|0.07699,1.20620,4.95857|0.00000,0.16099,1.93267|1.53425,0.58769,0.04838|2.63666,2.76951,2.80240|0.51114,0.51114,0.51114|0.00000,0.00000,0.00000' | split: '|' -%}
    {%- assign color_albedos_secondary = '5.13357,5.13357,5.13357|5.13357,3.42457,0.00421|5.11091,0.46563,0.00003|4.51682,0.21511,0.21511|0.83321,4.25881,0.23020|0.00000,2.32797,0.29964|0.20569,0.46563,0.04078|0.06114,1.02590,4.25881|0.00000,0.15026,1.67743|1.30508,0.50242,0.03445|2.26625,2.38502,2.41227|0.43156,0.43156,0.43156|0.00000,0.00000,0.00000' | split: '|' -%}

    <div class="product-form__input">
      <label class="form__label" for="CustomColorPrimary-{{ section.id }}">
        Primary Color (base and legs)
        <span
          class="product-custom-colors__swatch"
          data-swatch-for="CustomColorPrimary-{{ section.id }}"
        ></span>
      </label>
      <div class="select">
        <select
          id="CustomColorPrimary-{{ section.id }}"
          class="select__select"
          name="properties[Primary Color]"
          form="{{ product_form_id }}"
          data-custom-color="primary"
          required
          {% unless current_variation == 'Custom' %}
            disabled
          {% endunless %}
        >
          <option value="" disabled selected>Select an option</option>
          {%- for name in color_names -%}
            <option
              value="{{ name }}"
              data-hex="{{ color_hexes[forloop.index0] }}"
              data-albedo="{{ color_albedos_primary[forloop.index0] }}"
            >{{ name }}</option>
          {%- endfor -%}
        </select>
        <span class="svg-wrapper">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </div>
    </div>

    <div class="product-form__input">
      <label class="form__label" for="CustomColorSecondary-{{ section.id }}">
        Secondary Color (hopper, ladder and funnel)
        <span
          class="product-custom-colors__swatch"
          data-swatch-for="CustomColorSecondary-{{ section.id }}"
        ></span>
      </label>
      <div class="select">
        <select
          id="CustomColorSecondary-{{ section.id }}"
          class="select__select"
          name="properties[Secondary Color]"
          form="{{ product_form_id }}"
          data-custom-color="secondary"
          required
          {% unless current_variation == 'Custom' %}
            disabled
          {% endunless %}
        >
          <option value="" disabled selected>Select an option</option>
          {%- for name in color_names -%}
            <option
              value="{{ name }}"
              data-hex="{{ color_hexes[forloop.index0] }}"
              data-albedo="{{ color_albedos_secondary[forloop.index0] }}"
            >{{ name }}</option>
          {%- endfor -%}
        </select>
        <span class="svg-wrapper">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </div>
    </div>

    {% render 'product-custom-preview' %}

    <script type="application/json" data-variant-render-map>
      {
        "Patriot's Drive|Classic": {{ 'cw2-PatriotsDrive-Classic.webp' | asset_url | json }},
        "Patriot's Drive|Premium": {{ 'cw2-PatriotsDrive-Premium.webp' | asset_url | json }},
        "Augusta Aura|Classic": {{ 'cw2-AugustaAura-Classic.webp' | asset_url | json }},
        "Augusta Aura|Premium": {{ 'cw2-AugustaAura-Premium.webp' | asset_url | json }},
        "Caddie|Classic": {{ 'cw2-Caddie-Classic.webp' | asset_url | json }},
        "Caddie|Premium": {{ 'cw2-Caddie-Premium.webp' | asset_url | json }},
        "Golden Tee|Classic": {{ 'cw2-GoldenTee-Classic.webp' | asset_url | json }},
        "Golden Tee|Premium": {{ 'cw2-GoldenTee-Premium.webp' | asset_url | json }},
        "Ocean Drive|Classic": {{ 'cw2-OceanDrive-Classic.webp' | asset_url | json }},
        "Ocean Drive|Premium": {{ 'cw2-OceanDrive-Premium.webp' | asset_url | json }},
        "Tiger's Roar|Classic": {{ 'cw2-TigersRoar-Classic.webp' | asset_url | json }},
        "Tiger's Roar|Premium": {{ 'cw2-TigersRoar-Premium.webp' | asset_url | json }}
      }
    </script>
  </div>

  {% style %}
    .product-custom-colors .product-form__input {
      max-width: 44rem;
    }
    /* Overlays the product media gallery while a custom combo is chosen. */
    .product-custom-colors__preview[hidden] {
      display: none;
    }
    .product-custom-colors__preview {
      position: absolute;
      inset: 0;
      z-index: 4;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: rgb(var(--color-background)) url('{{ 'caddie-course-plate.webp' | asset_url }}') center / cover no-repeat;
    }
    .product-custom-colors__preview model-viewer {
      flex: 1 1 auto;
      width: 100%;
      min-height: 0;
    }
    .product-custom-colors__preview img {
      max-width: 100%;
      max-height: 90%;
      width: auto;
      height: auto;
      object-fit: contain;
    }
    /* The overlay sits on a photographic backdrop, so the caption needs its own
       opaque ground. A translucent chip over turf is unreadable (Paul, round 4). */
    .product-custom-colors__preview-chip {
      margin: 0.4rem 0 0;
      padding: 0.5rem 1.2rem;
      border-radius: 2rem;
      border: 0.1rem solid rgba(var(--color-foreground), 0.15);
      background: rgb(var(--color-background));
      color: rgb(var(--color-foreground));
      text-align: center;
    }
    /* Round 5: shown only while the preview is on the sample combo. */
    .product-custom-colors__preview-hint {
      margin: 0.4rem 0.4rem 0;
      padding: 0.3rem 1rem;
      border-radius: 2rem;
      background: rgb(var(--color-background));
      color: rgba(var(--color-foreground), 0.85);
      text-align: center;
    }
    .product-custom-colors__preview-hint[hidden] {
      display: none;
    }
    .product-custom-colors__preview-note {
      /* Narrow side margins on purpose: at a 375px viewport the 1.2rem margins
         cost enough width to push this to five lines. Round 4.3. */
      margin: 0.4rem 0.4rem 1rem;
      padding: 0.4rem 0.8rem;
      max-width: 34rem;
      border-radius: 1.2rem;
      background: rgb(var(--color-background));
      color: rgba(var(--color-foreground), 0.72);
      font-size: 0.85em;
      text-align: center;
    }
    .product-custom-colors__swatch {
      display: inline-block;
      width: 1.2rem;
      height: 1.2rem;
      margin-left: 0.5rem;
      border-radius: 50%;
      border: 0.1rem solid rgba(var(--color-foreground), 0.3);
      vertical-align: text-bottom;
      background: transparent;
    }
  {% endstyle %}

  <script>
    (function () {
      // Theme scripts (pubsub.js, constants.js) load deferred, so `subscribe`
      // and PUB_SUB_EVENTS do not exist while this inline script parses. Wait
      // for DOMContentLoaded, which fires after deferred scripts execute.
      function init() {
      var root = document.getElementById('ProductCustomColors-{{ section.id }}');
      if (!root || root.dataset.initialized) return;
      root.dataset.initialized = 'true';

      var variationIndex = parseInt(root.dataset.variationIndex, 10);
      var selects = root.querySelectorAll('select[data-custom-color]');

      var fieldsActive = !root.hidden;

      function setVisible(visible) {
        fieldsActive = visible;
        root.hidden = !visible;
        selects.forEach(function (sel) {
          sel.disabled = !visible;
        });
        refreshPreview();
      }

      function emit() {
        var detail = { primary: '', secondary: '', primaryHex: '', secondaryHex: '' };
        selects.forEach(function (sel) {
          var opt = sel.options[sel.selectedIndex];
          var hex = opt ? opt.getAttribute('data-hex') || '' : '';
          detail[sel.dataset.customColor] = sel.value;
          detail[sel.dataset.customColor + 'Hex'] = hex;
          detail[sel.dataset.customColor + 'Albedo'] = opt ? opt.getAttribute('data-albedo') || '' : '';
          var swatch = root.querySelector('[data-swatch-for="' + sel.id + '"]');
          if (swatch) swatch.style.background = hex || 'transparent';
        });
        document.dispatchEvent(new CustomEvent('curiousmaker:customcolors', { detail: detail }));
        updatePreview(detail);
      }

      var previewWrap = root.querySelector('[data-custom-preview]');
      var previewImg = document.getElementById('CustomColorPreview-{{ section.id }}');
      var previewMapEl = root.querySelector('[data-custom-preview-map]');

      // Show the preview on top of the product images, not under the fields:
      // move the overlay into the media gallery (Paul 2026-08-18).
      var gallery = document.getElementById('MediaGallery-{{ section.id }}');
      if (previewWrap && gallery) {
        if (!gallery.style.position) gallery.style.position = 'relative';
        // <media-gallery> is a custom element with no display of its own, so
        // below Dawn's desktop breakpoint it computes to display:inline. An
        // inline containing block resolves inset:0 to ZERO WIDTH, which
        // collapsed this whole overlay and made the 3D preview invisible on
        // narrow viewports. Verified pre-existing on unmodified code, found
        // round 4. Only touched when it is actually inline.
        if (getComputedStyle(gallery).display === 'inline') gallery.style.display = 'block';
        gallery.appendChild(previewWrap);
      }
      var previewMap = null;
      if (previewMapEl) {
        try { previewMap = JSON.parse(previewMapEl.textContent); } catch (e) { previewMap = null; }
      }

      var modelViewer = document.getElementById('CustomColorModel-{{ section.id }}');
      var modelFailed = false;
      var currentHexes = { primaryHex: '', secondaryHex: '', primaryAlbedo: '', secondaryAlbedo: '' };

      // Golf balls are not user selectable, so they never pass through a select.
      // They still need a calibrated factor: the GLB ships them at 0.9, which
      // renders near black under the calibrated exposure. Measured value below
      // reproduces their previous on screen appearance (approximate, sampled
      // from only 54 lit pixels since the balls are mostly occluded).
      var BALL_ALBEDO = [4.85817, 4.85817, 4.85817, 1];

      if (modelViewer) {
        modelViewer.addEventListener('error', function () {
          modelFailed = true;
          modelViewer.hidden = true;
          if (previewImg) previewImg.hidden = false;
        });
        modelViewer.addEventListener('load', function () {
          recolorModel();
        });
        if (typeof customElements !== 'undefined' && customElements.whenDefined) {
          var defined = false;
          customElements.whenDefined('model-viewer').then(function () { defined = true; });
          setTimeout(function () {
            if (!defined) {
              modelFailed = true;
              modelViewer.hidden = true;
              if (previewImg) previewImg.hidden = false;
            }
          }, 6000);
        }
      } else {
        modelFailed = true;
        if (previewImg) previewImg.hidden = false;
      }

      function srgbToLinear(c) {
        c = c / 255;
        return c <= 0.04045 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
      }

      function hexToLinearRgba(hex) {
        hex = hex.replace('#', '');
        return [
          srgbToLinear(parseInt(hex.slice(0, 2), 16)),
          srgbToLinear(parseInt(hex.slice(2, 4), 16)),
          srgbToLinear(parseInt(hex.slice(4, 6), 16)),
          1,
        ];
      }

      // Measured base color factor, "r,g,b" linear floats from data-albedo.
      // Returns null when the attribute is missing or malformed so the caller
      // can fall back to the raw hex.
      function parseAlbedo(str) {
        if (!str) return null;
        var parts = String(str).split(',');
        if (parts.length !== 3) return null;
        var out = [];
        for (var i = 0; i < 3; i++) {
          var v = parseFloat(parts[i]);
          if (!isFinite(v) || v < 0) return null;
          out.push(v);
        }
        out.push(1);
        return out;
      }

      function factorFor(albedoStr, hex) {
        return parseAlbedo(albedoStr) || (hex ? hexToLinearRgba(hex) : null);
      }

      function recolorModel() {
        if (modelFailed || !modelViewer || !modelViewer.model) return;
        var byName = {};
        modelViewer.model.materials.forEach(function (m) { byName[m.name] = m; });
        // Unconditional: Ball has no hex and no select, so it must not sit
        // behind either selection guard below.
        if (byName.Ball) {
          byName.Ball.pbrMetallicRoughness.setBaseColorFactor(BALL_ALBEDO);
        }
        if (currentHexes.primaryHex && byName.Primary) {
          var pf = factorFor(currentHexes.primaryAlbedo, currentHexes.primaryHex);
          if (pf) byName.Primary.pbrMetallicRoughness.setBaseColorFactor(pf);
        }
        if (currentHexes.secondaryHex && byName.Secondary) {
          var sf = factorFor(currentHexes.secondaryAlbedo, currentHexes.secondaryHex);
          if (sf) byName.Secondary.pbrMetallicRoughness.setBaseColorFactor(sf);
        }
      }

      // Round 5: the preview shows as soon as Custom is chosen, using a sample
      // combo, so customers can see that a live preview exists without having to
      // guess that picking two dropdowns will reveal one. The SELECTS are
      // deliberately NOT preselected: they stay empty and required, so the
      // default can never be mistaken for a choice and cannot reach an order.
      var DEFAULT_COMBO = { primary: 'Green', secondary: 'Yellow' };
      // Query from previewWrap, not root: the wrapper is moved into the media
      // gallery above, so by this point the hint is no longer a descendant of
      // root and root.querySelector returns null (caught in round 5 testing,
      // the hint silently never showed).
      var previewHint = previewWrap ? previewWrap.querySelector('[data-preview-hint]') : null;

      function optionData(role, value) {
        var out = { hex: '', albedo: '' };
        if (!value) return out;
        for (var i = 0; i < selects.length; i++) {
          if (selects[i].dataset.customColor !== role) continue;
          var opts = selects[i].options;
          for (var j = 0; j < opts.length; j++) {
            if (opts[j].value === value) {
              out.hex = opts[j].getAttribute('data-hex') || '';
              out.albedo = opts[j].getAttribute('data-albedo') || '';
              return out;
            }
          }
        }
        return out;
      }

      // What the PREVIEW should render: the user's pick per role where there is
      // one, the sample combo for the role that is still empty. Reads the
      // default's calibrated data-albedo out of the option list rather than
      // hard coding a hex, so it stays inside the matched set automatically.
      function effectiveFor(detail) {
        var eff = { usingDefault: false };
        ['primary', 'secondary'].forEach(function (role) {
          var chosen = detail[role];
          var name = chosen || DEFAULT_COMBO[role];
          if (!chosen) eff.usingDefault = true;
          var d = chosen
            ? { hex: detail[role + 'Hex'] || '', albedo: detail[role + 'Albedo'] || '' }
            : optionData(role, name);
          if (!d.hex && !d.albedo) d = optionData(role, name);
          eff[role] = name;
          eff[role + 'Hex'] = d.hex;
          eff[role + 'Albedo'] = d.albedo;
        });
        return eff;
      }

      function updatePreview(detail) {
        if (!previewWrap || !previewMap) return;
        if (!fieldsActive) {
          previewWrap.hidden = true;
          return;
        }
        var eff = effectiveFor(detail);
        // Albedo is stored with the hex it belongs to, never independently.
        // Storing it behind its own truthiness test would let a color that has
        // no data-albedo silently inherit the previously selected color's
        // albedo instead of falling back to its own hex.
        currentHexes.primaryHex = eff.primaryHex;
        currentHexes.primaryAlbedo = eff.primaryAlbedo;
        currentHexes.secondaryHex = eff.secondaryHex;
        currentHexes.secondaryAlbedo = eff.secondaryAlbedo;

        var url = previewMap[eff.primary + '__' + eff.secondary];
        if (url && previewImg) previewImg.src = url;
        if (modelViewer && !modelFailed && !modelViewer.getAttribute('src')) {
          modelViewer.setAttribute('src', modelViewer.dataset.glbSrc);
        }
        recolorModel();
        if (previewHint) previewHint.hidden = !eff.usingDefault;
        previewWrap.hidden = false;
      }

      function refreshPreview() {
        var detail = { primary: '', secondary: '', primaryHex: '', secondaryHex: '' };
        selects.forEach(function (sel) {
          var opt = sel.options[sel.selectedIndex];
          detail[sel.dataset.customColor] = sel.value;
          detail[sel.dataset.customColor + 'Hex'] = opt ? opt.getAttribute('data-hex') || '' : '';
          detail[sel.dataset.customColor + 'Albedo'] = opt ? opt.getAttribute('data-albedo') || '' : '';
        });
        updatePreview(detail);
      }

      selects.forEach(function (sel) {
        sel.addEventListener('change', emit);
      });

      // Per variant lifestyle render as the SECOND gallery slide (named
      // variations only; Custom uses the interactive overlay instead).
      var setIndex = parseInt(root.dataset.setIndex, 10);
      var renderMapEl = root.querySelector('[data-variant-render-map]');
      var renderMap = null;
      if (renderMapEl) {
        try { renderMap = JSON.parse(renderMapEl.textContent); } catch (e) { renderMap = null; }
      }

      function updateVariantSlide(variation, set) {
        if (!renderMap) return;
        var list = document.getElementById('Slider-Gallery-{{ section.id }}');
        if (!list) return;
        var slide = list.querySelector('[data-cm-variant-render]');
        var url = variation && set ? renderMap[variation + '|' + set] : null;
        if (!url) {
          if (slide) slide.hidden = true;
          return;
        }
        if (!slide) {
          var first = list.querySelector('li');
          if (!first) return;
          slide = document.createElement('li');
          slide.className = 'product__media-item grid__item slider__slide';
          slide.setAttribute('data-cm-variant-render', '');
          slide.innerHTML = '<div class="product__media media media--transparent" style="padding-top: 148.6%; position: relative;">' +
            '<img alt="Rendered view of this color set" loading="lazy" ' +
            'style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;"></div>';
          first.insertAdjacentElement('afterend', slide);
        }
        slide.hidden = false;
        var img = slide.querySelector('img');
        if (img.getAttribute('src') !== url) img.setAttribute('src', url);
      }

      var initialVariation = root.dataset.initialVariation || '';
      var initialSet = root.dataset.initialSet || '';
      if (initialVariation && initialVariation !== 'Custom') updateVariantSlide(initialVariation, initialSet);

      if (typeof subscribe === 'function' && typeof PUB_SUB_EVENTS !== 'undefined' && PUB_SUB_EVENTS.variantChange) {
        subscribe(PUB_SUB_EVENTS.variantChange, function (event) {
          var variant = event && event.data && event.data.variant;
          if (!variant || variationIndex < 0) {
            setVisible(false);
            updateVariantSlide(null, null);
            return;
          }
          var v = variant.options[variationIndex];
          setVisible(v === 'Custom');
          updateVariantSlide(v === 'Custom' ? null : v, setIndex > -1 ? variant.options[setIndex] : '');
        });
      }

      // The product form carries `novalidate`; enforce required-ness on the
      // add to cart click, before the AJAX submit handler runs.
      document.addEventListener(
        'click',
        function (evt) {
          var button = evt.target && evt.target.closest && evt.target.closest('button[type="submit"], button[name="add"]');
          if (!button) return;
          var form = button.form || button.closest('form');
          if (!form || form.getAttribute('id') !== {{ product_form_id | json }}) return;
          for (var i = 0; i < selects.length; i++) {
            if (!selects[i].disabled && !selects[i].checkValidity()) {
              evt.preventDefault();
              evt.stopImmediatePropagation();
              selects[i].reportValidity();
              return;
            }
          }
        },
        true
      );

      emit();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    })();
  </script>
{%- endif -%}
