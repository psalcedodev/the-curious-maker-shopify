{% comment %}
  Renders the personalization fields for the fidget clicker product.
  Both fields submit as line item properties on the product form, matching
  the Etsy listing (Color Options + Personalization Details).

  Accepts:
  - product: {Object} Product Liquid object
  - product_form_id: {String} id of the product form the fields submit with

  The product form is rendered with `novalidate`, so required-ness is
  enforced by the click interceptor at the bottom of this snippet, which
  runs before the AJAX add-to-cart handler and shows the native message
  via reportValidity().

  Usage:
  {% render 'product-personalization', product: product, product_form_id: product_form_id %}
{% endcomment %}

{%- if product.handle == 'personalized-keycap-fidget-clicker-keychain-custom-name-or-word-sensory-toy-3d-printed-gift' -%}
  <div class="product-personalization" id="ProductPersonalization-{{ section.id }}">
    <div class="product-form__input">
      <label class="form__label" for="PersonalizationColor-{{ section.id }}">
        Color Options (See Listing Photos)
      </label>
      <div class="select">
        <select
          id="PersonalizationColor-{{ section.id }}"
          class="select__select"
          name="properties[Color Options]"
          form="{{ product_form_id }}"
          required
        >
          {%- comment -%}
            Clicker color collections, matching the Etsy listing photos
            (Paul 2026-08-18: the clicker does NOT use the PETG palette).
          {%- endcomment -%}
          <option value="" disabled selected>Select an option</option>
          {%- assign clicker_colors = '1. Snowberry|2. Blush|3. Sky|4. Cloud|5. Lavender|6. Wisteria|7. Matcha|8. Vanilla Latte|9. Cafe Au Lait|10. Espresso|11. Cotton Candy|12. Lemon Drop|13. Peach Sorbet|14. Taffy|15. Cookies & Cream' | split: '|' -%}
          {%- for name in clicker_colors -%}
            <option value="{{ name }}">{{ name }}</option>
          {%- endfor -%}
        </select>
        <span class="svg-wrapper">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </div>
    </div>

    <div class="product-form__input">
      <label class="form__label" for="PersonalizationDetails-{{ section.id }}">
        Personalization Details
      </label>
      <p class="caption product-personalization__help">
        Enter text, number, &amp; or symbol<br>
        Ex: Lia, 18, cat symbol
      </p>
      <div class="field">
        <textarea
          id="PersonalizationDetails-{{ section.id }}"
          class="text-area text-area--resize-vertical field__input"
          name="properties[Personalization Details]"
          form="{{ product_form_id }}"
          rows="4"
          maxlength="500"
          required
        ></textarea>
      </div>
      <p class="caption product-personalization__counter">
        <span id="PersonalizationCounter-{{ section.id }}">0</span>/500
      </p>
    </div>
  </div>

  {% style %}
    .product-personalization .product-form__input {
      max-width: 44rem;
    }
    .product-personalization__help {
      margin: 0.4rem 0 0.8rem;
      color: rgba(var(--color-foreground), 0.75);
    }
    .product-personalization__counter {
      margin: 0.4rem 0 0;
      text-align: right;
      color: rgba(var(--color-foreground), 0.75);
    }
  {% endstyle %}

  <script>
    (function () {
      var root = document.getElementById('ProductPersonalization-{{ section.id }}');
      if (!root || root.dataset.initialized) return;
      root.dataset.initialized = 'true';

      var textarea = document.getElementById('PersonalizationDetails-{{ section.id }}');
      var counter = document.getElementById('PersonalizationCounter-{{ section.id }}');
      if (textarea && counter) {
        var updateCounter = function () {
          counter.textContent = String(textarea.value.length);
        };
        textarea.addEventListener('input', updateCounter);
        updateCounter();
      }

      // The product form carries `novalidate`, so intercept the add-to-cart
      // click in the capture phase (runs before the AJAX submit handler) and
      // surface the native validation message for our fields.
      document.addEventListener(
        'click',
        function (evt) {
          var button = evt.target && evt.target.closest && evt.target.closest('button[type="submit"], button[name="add"]');
          if (!button) return;
          var form = button.form || button.closest('form');
          if (!form || form.getAttribute('id') !== {{ product_form_id | json }}) return;
          var fields = root.querySelectorAll('select[required], textarea[required]');
          for (var i = 0; i < fields.length; i++) {
            if (!fields[i].disabled && !fields[i].checkValidity()) {
              evt.preventDefault();
              evt.stopImmediatePropagation();
              fields[i].reportValidity();
              return;
            }
          }
        },
        true
      );
    })();
  </script>
{%- endif -%}
