{% comment %}
  Renders the personalization fields for the fidget clicker product.

  Color Options stays exactly as it was: a required line item property select
  carrying the 15 named color sets plus "Custom (Enter Below)". Choosing Custom
  reveals three required Case/Keycap/Letter selects, which are hidden AND
  disabled otherwise so nothing stray submits.

  Personalization Details is no longer typed free form. The composer below
  builds the word one keycap at a time and serializes it into a hidden input
  under the same property name the shop already reads, with symbols bracketed:
  PAUL[Heart].

  Cap count comes from the selected "Number of Characters" variant option
  (the last integer in the option value), and re-limits live on variant change.

  Accepts:
  - product: {Object} Product Liquid object
  - product_form_id: {String} id of the product form the fields submit with

  The product form is rendered with `novalidate`, so required-ness is enforced
  by the click interceptor at the bottom of this snippet, which runs before the
  AJAX add-to-cart handler. Visible selects get the native message via
  reportValidity(); the hidden Personalization Details input is barred from
  constraint validation, so an empty composer gets its own visible message.

  Symbol art: base64 PNG masks from the Studio vault,
  projects/giftofbliss/content/icon-masks.json, painted with currentColor via
  CSS mask-image so a cap letter color tints them.

  Usage:
  {% render 'product-personalization', product: product, product_form_id: product_form_id %}
{% endcomment %}

{%- if product.handle == 'personalized-keycap-fidget-clicker-keychain-custom-name-or-word-sensory-toy-3d-printed-gift' -%}
  {%- liquid
    assign characters_index = -1
    for option in product.options_with_values
      if option.name == 'Number of Characters'
        assign characters_index = forloop.index0
      endif
    endfor
    assign initial_characters = ''
    if characters_index > -1
      assign initial_characters = product.selected_or_first_available_variant.options[characters_index]
    endif
  -%}

  <div
    class="product-personalization"
    id="ProductPersonalization-{{ section.id }}"
    data-characters-index="{{ characters_index }}"
    data-initial-characters="{{ initial_characters | escape }}"
  >
    <div class="product-form__input">
      <label class="form__label product-personalization__label" for="PersonalizationColor-{{ section.id }}">
        Color Options (See Listing Photos)
      </label>
      <div class="select">
        <select
          id="PersonalizationColor-{{ section.id }}"
          class="select__select"
          name="properties[Color Options]"
          form="{{ product_form_id }}"
          required
        >
          {%- comment -%}
            Clicker color collections, matching the Etsy listing photos
            (Paul 2026-08-18: the clicker does NOT use the PETG palette).
          {%- endcomment -%}
          <option value="" disabled selected>Select an option</option>
          {%- assign clicker_colors = '1. Snowberry|2. Blush|3. Sky|4. Cloud|5. Lavender|6. Wisteria|7. Matcha|8. Vanilla Latte|9. Cafe Au Lait|10. Espresso|11. Cotton Candy|12. Lemon Drop|13. Peach Sorbet|14. Taffy|15. Cookies & Cream' | split: '|' -%}
          {%- for name in clicker_colors -%}
            <option value="{{ name }}">{{ name }}</option>
          {%- endfor -%}
          <option value="Custom (Enter Below)">Custom (Enter Below)</option>
        </select>
        <span class="svg-wrapper">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </div>
    </div>

    <div class="product-personalization__composer">
      <label class="form__label product-personalization__label" for="PersonalizationTypebox-{{ section.id }}">
        Personalization Details
      </label>
      <p class="product-personalization__help">
        Type letters or numbers, or tap a symbol to add one. Each tile is one keycap,
        built in this order. Tap a tile to take it off.
      </p>

      <div class="product-personalization__caps" data-cap-row title="Click and type"></div>
      <p class="product-personalization__counter" data-cap-counter aria-live="polite"></p>

      {%- comment -%}
        The custom color trio sits directly under the preview, so the swatch a
        shopper picks and the cap it repaints stay in one glance.
      {%- endcomment -%}
      <div class="product-personalization__custom" data-custom-colors hidden>
        <p class="product-personalization__custom-label">
          Custom colors. Pick one for each part and the preview updates.
        </p>
        <div class="product-personalization__custom-grid">
          <div class="product-personalization__custom-field">
            <label class="form__label product-personalization__sub-label" for="PersonalizationCase-{{ section.id }}">
              Case
              <span class="product-personalization__swatch" data-swatch-for="PersonalizationCase-{{ section.id }}"></span>
            </label>
            <div class="select">
              <select
                id="PersonalizationCase-{{ section.id }}"
                class="select__select"
                name="properties[Case Color]"
                form="{{ product_form_id }}"
                data-custom-color="case"
                required
                disabled
              >
                <option value="" disabled selected>Color</option>
                <option value="White">White</option>
                <option value="Pink">Pink</option>
                <option value="Blue">Blue</option>
                <option value="Purple">Purple</option>
                <option value="Green">Green</option>
                <option value="Beige">Beige</option>
                <option value="Caramel">Caramel</option>
                <option value="Brown">Brown</option>
                <option value="Yellow">Yellow</option>
                <option value="Peach">Peach</option>
                <option value="Charcoal">Charcoal</option>
              </select>
              <span class="svg-wrapper">
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </span>
            </div>
          </div>
          <div class="product-personalization__custom-field">
            <label class="form__label product-personalization__sub-label" for="PersonalizationKeycap-{{ section.id }}">
              Keycap
              <span class="product-personalization__swatch" data-swatch-for="PersonalizationKeycap-{{ section.id }}"></span>
            </label>
            <div class="select">
              <select
                id="PersonalizationKeycap-{{ section.id }}"
                class="select__select"
                name="properties[Keycap Color]"
                form="{{ product_form_id }}"
                data-custom-color="cap"
                required
                disabled
              >
                <option value="" disabled selected>Color</option>
                <option value="White">White</option>
                <option value="Pink">Pink</option>
                <option value="Blue">Blue</option>
                <option value="Purple">Purple</option>
                <option value="Green">Green</option>
                <option value="Beige">Beige</option>
                <option value="Caramel">Caramel</option>
                <option value="Brown">Brown</option>
                <option value="Yellow">Yellow</option>
                <option value="Peach">Peach</option>
                <option value="Charcoal">Charcoal</option>
              </select>
              <span class="svg-wrapper">
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </span>
            </div>
          </div>
          <div class="product-personalization__custom-field">
            <label class="form__label product-personalization__sub-label" for="PersonalizationLetter-{{ section.id }}">
              Letter
              <span class="product-personalization__swatch" data-swatch-for="PersonalizationLetter-{{ section.id }}"></span>
            </label>
            <div class="select">
              <select
                id="PersonalizationLetter-{{ section.id }}"
                class="select__select"
                name="properties[Letter Color]"
                form="{{ product_form_id }}"
                data-custom-color="letter"
                required
                disabled
              >
                <option value="" disabled selected>Color</option>
                <option value="White">White</option>
                <option value="Pink">Pink</option>
                <option value="Blue">Blue</option>
                <option value="Purple">Purple</option>
                <option value="Green">Green</option>
                <option value="Beige">Beige</option>
                <option value="Caramel">Caramel</option>
                <option value="Brown">Brown</option>
                <option value="Yellow">Yellow</option>
                <option value="Peach">Peach</option>
                <option value="Charcoal">Charcoal</option>
              </select>
              <span class="svg-wrapper">
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </span>
            </div>
          </div>
        </div>
      </div>

      <div class="field product-personalization__typebox">
        <input
          id="PersonalizationTypebox-{{ section.id }}"
          class="field__input"
          type="text"
          data-typebox
          maxlength="1"
          autocomplete="off"
          autocapitalize="characters"
          spellcheck="false"
          placeholder="Type a letter or number"
          aria-describedby="PersonalizationHelp-{{ section.id }}"
        >
        <label class="field__label" for="PersonalizationTypebox-{{ section.id }}">
          Type a letter or number
        </label>
      </div>

      <p class="product-personalization__palette-label" id="PersonalizationHelp-{{ section.id }}">
        Or tap a symbol. Each symbol takes one cap.
      </p>
      <div class="product-personalization__palette" data-palette></div>

      <p class="product-personalization__error" data-composer-error role="alert" hidden></p>

      <input
        type="hidden"
        id="PersonalizationDetails-{{ section.id }}"
        name="properties[Personalization Details]"
        form="{{ product_form_id }}"
        value=""
        required
      >
    </div>
  </div>

  {% style %}
    .product-personalization .product-form__input {
      max-width: 44rem;
      margin: 2.4rem 0 0;
    }
    .product-personalization__composer {
      max-width: 44rem;
      margin-top: 2.4rem;
      padding-top: 2.4rem;
      border-top: 0.1rem solid rgba(var(--color-foreground), 0.15);
    }
    label.product-personalization__label {
      display: block;
      margin: 0 0 0.6rem;
      font-size: 1.4rem;
      font-weight: 600;
      line-height: 1.4;
      letter-spacing: 0.04rem;
      color: rgb(var(--color-foreground));
    }
    .product-personalization__help,
    .product-personalization__palette-label,
    .product-personalization__custom-label {
      font-size: 1.3rem;
      line-height: 1.5;
      letter-spacing: 0.02rem;
      color: rgba(var(--color-foreground), 0.75);
    }
    .product-personalization__help {
      margin: 0 0 1.2rem;
    }
    .product-personalization__custom-label {
      margin: 0 0 0.6rem;
    }
    .product-personalization__palette-label {
      margin: 1.6rem 0 0.6rem;
    }
    label.product-personalization__sub-label {
      font-size: 1.2rem;
      line-height: 1.4;
      letter-spacing: 0.02rem;
      color: rgba(var(--color-foreground), 0.75);
    }
    div.product-personalization__caps {
      display: flex;
      flex-wrap: nowrap;
      align-items: flex-start;
      gap: 4px;
      padding: 4px 0;
      background: transparent;
      border: 0;
      cursor: text;
    }
    .product-personalization__strip {
      display: inline-flex;
      flex-wrap: nowrap;
      width: max-content;
      max-width: 100%;
      gap: 4px;
      padding: 5px 5px 9px;
      border-radius: 12px;
      background: rgba(var(--color-foreground), 0.14);
    }
    .product-personalization__cap {
      width: 52px;
      height: 56px;
      border-radius: 11px;
      position: relative;
      cursor: pointer;
      background: #e7e3db;
      border: 1px solid #d4cec3;
      box-shadow: inset 0 1px 2px rgba(255, 255, 255, 0.3), inset 0 -2px 3px rgba(0, 0, 0, 0.07);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Arial Rounded MT Bold', ui-rounded, 'Helvetica Neue', Arial, sans-serif;
      font-weight: 700;
      font-size: 26px;
      line-height: 1;
      color: #3a3a3a;
      transition: transform 0.08s ease;
    }
    .product-personalization__cap:hover {
      transform: translateY(1px);
    }
    /* Always on show, not hover only, so the remove affordance is discoverable
       on touch. --pp-badge is set per cap in JS because the cap width is
       computed, not fixed. z-index lifts it over the next cap: the caps are
       positioned siblings with auto z-index, so in DOM order the neighbour
       would otherwise paint over the half that hangs outside. Ghosts have
       their own class and never get one. */
    .product-personalization__cap::after {
      content: '\00d7';
      position: absolute;
      top: calc(var(--pp-badge, 16px) * -0.5);
      right: calc(var(--pp-badge, 16px) * -0.5);
      width: var(--pp-badge, 16px);
      height: var(--pp-badge, 16px);
      background: #2f2f2f;
      color: #fff;
      border-radius: 50%;
      font-family: sans-serif;
      font-weight: 700;
      font-size: calc(var(--pp-badge, 16px) * 0.62);
      line-height: var(--pp-badge, 16px);
      text-align: center;
      opacity: 0.38;
      z-index: 3;
      pointer-events: none;
      transition: opacity 0.12s ease;
    }
    .product-personalization__cap:hover::after,
    .product-personalization__cap:focus-visible::after {
      opacity: 1;
    }
    div.product-personalization__ghost {
      width: 52px;
      height: 56px;
      border-radius: 11px;
      border: 1.5px dashed rgba(var(--color-foreground), 0.28);
      background: transparent;
      box-shadow: none;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .product-personalization__icon {
      display: inline-block;
      width: 28px;
      height: 28px;
      background-color: currentColor;
      -webkit-mask-size: contain;
      mask-size: contain;
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
      -webkit-mask-position: center;
      mask-position: center;
    }
    .product-personalization__chip .product-personalization__icon {
      width: 24px;
      height: 24px;
    }
    .product-personalization__counter {
      margin: 0.6rem 0 0;
      font-size: 1.2rem;
      line-height: 1.4;
      letter-spacing: 0.02rem;
      text-align: right;
      color: rgba(var(--color-foreground), 0.75);
    }
    .product-personalization__counter.is-full {
      color: rgb(var(--color-foreground));
    }
    .product-personalization__typebox {
      margin-top: 1.6rem;
    }
    div.product-personalization__palette {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }
    .product-personalization__chip {
      width: 44px;
      height: 44px;
      padding: 0;
      border-radius: 8px;
      border: 0.1rem solid rgba(var(--color-foreground), 0.2);
      background: rgb(var(--color-background));
      color: rgb(var(--color-foreground));
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.1s ease;
    }
    .product-personalization__chip:hover {
      background: rgba(var(--color-foreground), 0.06);
    }
    .product-personalization__chip:active {
      transform: scale(0.93);
    }
    .product-personalization__chip[disabled] {
      opacity: 0.35;
      cursor: not-allowed;
    }
    .product-personalization__error {
      margin: 1.6rem 0 0;
      font-size: 1.4rem;
      line-height: 1.4;
      color: #d32f2f;
    }
    .product-personalization__custom {
      margin-top: 1.6rem;
    }
    .product-personalization__custom-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
    }
    .product-personalization__custom-field {
      flex: 1 1 12rem;
      min-width: 0;
    }
    .product-personalization__custom-field label.product-personalization__sub-label {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      margin: 0 0 0.4rem;
    }
    .product-personalization__swatch {
      display: inline-block;
      width: 1.4rem;
      height: 1.4rem;
      border-radius: 50%;
      border: 0.1rem solid rgba(var(--color-foreground), 0.25);
      background: transparent;
    }
    .product-personalization__caps.is-flashing {
      animation: personalization-flash 0.35s ease;
    }
    @keyframes personalization-flash {
      0% {
        box-shadow: 0 0 0 3px rgba(var(--color-foreground), 0.4);
      }
      100% {
        box-shadow: none;
      }
    }
  {% endstyle %}

  <script>
    (function () {
      // Theme scripts (pubsub.js, constants.js) load deferred, so `subscribe`
      // and PUB_SUB_EVENTS do not exist while this inline script parses. Wait
      // for DOMContentLoaded, which fires after deferred scripts execute.
      function init() {
      var root = document.getElementById('ProductPersonalization-{{ section.id }}');
      if (!root || root.dataset.initialized) return;
      root.dataset.initialized = 'true';

      var SYMBOLS = [
        ['Bow', ''],
        ['Clover', ''],
        ['Flower', ''],
        ['Cat', ''],
        ['Cloud', ''],
        ['Paw Print', ''],
        ['Duck', ''],
        ['Heart', ''],
        ['Star', ''],
        ['Moon', ''],
        ['Fire', ''],
        ['Lightning', ''],
        ['Airplane', ''],
        ['Music Note', ''],
        ['Coffee Cup', '']
      ];

      var C = {
        White: '#FAF9F6',
        Pink: '#F7CED7',
        Blue: '#A4DBE8',
        Purple: '#8B6CBC',
        Green: '#68724D',
        Beige: '#F7E6DE',
        Caramel: '#AE835B',
        Brown: '#6F5034',
        Yellow: '#F7D959',
        Peach: '#FFB673',
        Charcoal: '#424344',
      };

      // case / keycap / letter per named color set, keyed by the option label
      // with its leading "N. " stripped.
      var COMBOS = {
        'Snowberry': { case_: C.White, cap: C.Pink, letter: C.White },
        'Blush': { case_: C.Pink, cap: C.Pink, letter: C.White },
        'Sky': { case_: C.Blue, cap: C.Blue, letter: C.White },
        'Cloud': { case_: C.White, cap: C.Blue, letter: C.White },
        'Lavender': { case_: C.Purple, cap: C.Purple, letter: C.White },
        'Wisteria': { case_: C.White, cap: C.Purple, letter: C.White },
        'Matcha': { case_: C.Green, cap: C.White, letter: C.Green },
        'Vanilla Latte': { case_: C.Beige, cap: C.Caramel, letter: C.Beige },
        'Cafe Au Lait': { case_: C.Caramel, cap: C.Beige, letter: C.Caramel },
        'Espresso': { case_: C.Brown, cap: C.Beige, letter: C.Brown },
        'Cotton Candy': { case_: C.Pink, cap: C.Blue, letter: C.Pink },
        'Lemon Drop': { case_: C.Yellow, cap: C.White, letter: C.Yellow },
        'Peach Sorbet': { case_: C.Peach, cap: C.White, letter: C.Peach },
        'Taffy': { case_: C.Purple, cap: C.Yellow, letter: C.Purple },
        'Cookies & Cream': { case_: C.Charcoal, cap: C.White, letter: C.Charcoal },
      };

      function shade(hex, f) {
        var n = parseInt(hex.slice(1), 16), r = n >> 16, g = (n >> 8) & 255, b = n & 255;
        r = Math.round(r * f); g = Math.round(g * f); b = Math.round(b * f);
        return '#' + ((1 << 24) + (r << 16) + (g << 8) + b).toString(16).slice(1);
      }
      function lighten(hex, f) {
        var n = parseInt(hex.slice(1), 16), r = n >> 16, g = (n >> 8) & 255, b = n & 255;
        r = Math.round(r + (255 - r) * f); g = Math.round(g + (255 - g) * f); b = Math.round(b + (255 - b) * f);
        return '#' + ((1 << 24) + (r << 16) + (g << 8) + b).toString(16).slice(1);
      }

      function icon(b64) {
        var u = 'url(data:image/png;base64,' + b64 + ')';
        return '<span class="product-personalization__icon" style="-webkit-mask-image:' + u + ';mask-image:' + u + '"></span>';
      }

      var colorSelect = document.getElementById('PersonalizationColor-{{ section.id }}');
      var detailsInput = document.getElementById('PersonalizationDetails-{{ section.id }}');
      var row = root.querySelector('[data-cap-row]');
      var counter = root.querySelector('[data-cap-counter]');
      var typebox = root.querySelector('[data-typebox]');
      var palette = root.querySelector('[data-palette]');
      var errorEl = root.querySelector('[data-composer-error]');
      var customWrap = root.querySelector('[data-custom-colors]');
      var customSelects = Array.prototype.slice.call(root.querySelectorAll('select[data-custom-color]'));
      if (!row || !typebox || !palette || !detailsInput) return;

      var tokens = [];
      var charactersIndex = parseInt(root.dataset.charactersIndex, 10);
      var lastWidth = -1;

      // "1-2 Characters" gives 2, "3-8 Characters" gives 8, "9-10 Characters"
      // gives 10. Reading the last integer rather than matching the whole label
      // keeps this working if the option text is ever reworded.
      function budgetFrom(value) {
        var found = String(value == null ? '' : value).match(/\d+/g);
        if (!found || !found.length) return 8;
        var n = parseInt(found[found.length - 1], 10);
        return isFinite(n) && n > 0 ? n : 8;
      }

      var budget = budgetFrom(root.dataset.initialCharacters);

      function comboKey(value) {
        return String(value || '').replace(/^\s*\d+\.\s*/, '').trim();
      }

      function isCustom() {
        return !!colorSelect && colorSelect.value === 'Custom (Enter Below)';
      }

      function currentTint() {
        if (!colorSelect || !colorSelect.value) return null;
        if (isCustom()) {
          var picked = {};
          var complete = true;
          customSelects.forEach(function (sel) {
            if (!sel.value) complete = false;
            else picked[sel.dataset.customColor] = C[sel.value];
          });
          if (!complete) return null;
          return { case_: picked['case'], cap: picked['cap'], letter: picked['letter'] };
        }
        return COMBOS[comboKey(colorSelect.value)] || null;
      }

      function serialize() {
        return tokens
          .map(function (t) {
            return t.t === 'ch' ? t.v : '[' + t.name + ']';
          })
          .join('');
      }

      function hideError() {
        if (!errorEl) return;
        errorEl.hidden = true;
        errorEl.textContent = '';
      }

      function showError(message) {
        if (!errorEl) return;
        errorEl.textContent = message;
        errorEl.hidden = false;
        row.classList.remove('is-flashing');
        void row.offsetWidth;
        row.classList.add('is-flashing');
      }

      function addToken(tok) {
        if (tokens.length >= budget) {
          row.classList.remove('is-flashing');
          void row.offsetWidth;
          row.classList.add('is-flashing');
          return;
        }
        tokens.push(tok);
        hideError();
        render();
      }

      function removeAt(i) {
        tokens.splice(i, 1);
        render();
      }

      // Sizing math copied verbatim from the approved mock: always one row, the
      // caps shrink proportionally to fit the budget in the available width.
      function render() {
        row.innerHTML = '';
        var tint = currentTint();
        var avail = row.clientWidth || row.parentElement.clientWidth;
        lastWidth = avail;
        var n = budget;
        var w = 52, pad = 5, gap = 4;
        for (var it = 0; it < 4; it++) {
          pad = Math.max(3, Math.round(w * 0.1));
          gap = Math.max(2, Math.round(w * 0.08));
          var fit = Math.floor((avail - pad * 2 - (n - 1) * gap) / n);
          w = Math.max(20, Math.min(52, fit));
        }
        var h = Math.round((w * 56) / 52),
          rad = Math.max(4, Math.round((w * 11) / 52)),
          fs = Math.round(w * 0.5),
          ic = Math.round(w * 0.54);

        function sizeTile(el) {
          el.style.width = w + 'px';
          el.style.height = h + 'px';
          el.style.borderRadius = rad + 'px';
          el.style.fontSize = fs + 'px';
        }

        var strip = document.createElement('div');
        strip.className = 'product-personalization__strip';
        strip.style.gap = gap + 'px';
        strip.style.padding = pad + 'px ' + pad + 'px ' + (pad + Math.max(2, Math.round(w * 0.08))) + 'px';
        strip.style.borderRadius = Math.max(6, Math.round((w * 12) / 52)) + 'px';
        row.style.gap = gap + 'px';
        row.style.minHeight = h + pad * 2 + Math.round(w * 0.08) + 2 + 'px';
        if (tint) {
          strip.style.background = tint.case_;
          strip.style.boxShadow = 'inset 0 -2px 3px ' + shade(tint.case_, 0.85);
        }

        tokens.forEach(function (t, i) {
          var d = document.createElement('div');
          d.className = 'product-personalization__cap';
          d.title = 'Remove';
          sizeTile(d);
          d.style.setProperty('--pp-badge', Math.max(12, Math.round(w * 0.3)) + 'px');
          if (tint) {
            d.style.background =
              'linear-gradient(180deg,' + lighten(tint.cap, 0.07) + ' 0%,' + tint.cap + ' 45%,' + shade(tint.cap, 0.95) + ' 100%)';
            d.style.borderColor = shade(tint.cap, 0.88);
            d.style.boxShadow = 'inset 0 1px 2px rgba(255,255,255,.28), inset 0 -2px 3px rgba(0,0,0,.08)';
            d.style.color = tint.letter;
          }
          if (t.t === 'ch') {
            d.textContent = t.v;
          } else {
            var sp = document.createElement('span');
            sp.innerHTML = icon(t.b64);
            var iconEl = sp.querySelector('.product-personalization__icon');
            if (iconEl) {
              iconEl.style.width = ic + 'px';
              iconEl.style.height = ic + 'px';
            }
            d.appendChild(sp);
          }
          d.addEventListener('click', function () {
            removeAt(i);
          });
          strip.appendChild(d);
        });
        if (tokens.length) row.appendChild(strip);
        for (var gi = tokens.length; gi < budget; gi++) {
          var gh = document.createElement('div');
          gh.className = 'product-personalization__ghost';
          sizeTile(gh);
          row.appendChild(gh);
        }

        if (counter) {
          counter.textContent = tokens.length + ' of ' + budget + ' caps used';
          counter.className = 'product-personalization__counter' + (tokens.length >= budget ? ' is-full' : '');
        }
        detailsInput.value = tokens.length ? serialize() : '';
        palette.querySelectorAll('.product-personalization__chip').forEach(function (c) {
          c.disabled = tokens.length >= budget;
        });
      }

      SYMBOLS.forEach(function (s) {
        var b = document.createElement('button');
        b.className = 'product-personalization__chip';
        b.type = 'button';
        b.title = s[0];
        b.setAttribute('aria-label', 'Add ' + s[0]);
        b.innerHTML = icon(s[1]);
        // A chip is a real button, so the browser activates it on Space and
        // Enter. The typebox sits immediately before the palette in tab order,
        // so a shopper who tabs out of it and keeps typing was silently filling
        // every slot with the first symbol: space is an ordinary keystroke when
        // you believe you are still typing a name. Two guards, neither of which
        // costs keyboard operability.
        b.addEventListener('keydown', function (e) {
          // A held Space or Enter auto-repeats; one press should mean one cap.
          if (e.repeat && (e.key === ' ' || e.key === 'Enter' || e.key === 'Spacebar')) e.preventDefault();
        });
        b.addEventListener('click', function () {
          addToken({ t: 'sym', name: s[0], b64: s[1] });
          // Put the caret back where the composing happens, so the next
          // keystroke goes to the typebox instead of re-firing this chip.
          typebox.focus({ preventScroll: true });
        });
        palette.appendChild(b);
      });

      typebox.addEventListener('input', function () {
        var ch = typebox.value.slice(-1);
        typebox.value = '';
        if (/^[a-zA-Z0-9&]$/.test(ch)) addToken({ t: 'ch', v: ch.toUpperCase() });
      });
      typebox.addEventListener('keydown', function (e) {
        if (e.key === 'Backspace' && !typebox.value && tokens.length) {
          removeAt(tokens.length - 1);
          e.preventDefault();
        }
        if (e.key === 'Enter') e.preventDefault();
      });
      row.addEventListener('click', function (e) {
        if (e.target === row || (e.target.classList && e.target.classList.contains('product-personalization__ghost'))) {
          typebox.focus();
        }
      });

      function syncCustom() {
        var show = isCustom();
        if (customWrap) customWrap.hidden = !show;
        customSelects.forEach(function (sel) {
          sel.disabled = !show;
          if (!show) sel.value = '';
          var swatch = root.querySelector('[data-swatch-for="' + sel.id + '"]');
          if (swatch) swatch.style.background = show && sel.value ? C[sel.value] : 'transparent';
        });
      }

      if (colorSelect) {
        colorSelect.addEventListener('change', function () {
          syncCustom();
          render();
        });
      }
      customSelects.forEach(function (sel) {
        sel.addEventListener('change', function () {
          var swatch = root.querySelector('[data-swatch-for="' + sel.id + '"]');
          if (swatch) swatch.style.background = sel.value ? C[sel.value] : 'transparent';
          render();
        });
      });

      // The cap row is laid out at zero width on the first pass, so the sizing
      // math would floor every cap at 20px. Re-render once the box has a real
      // width, and again whenever the product column resizes (which does not
      // always fire a window resize).
      function renderIfResized() {
        var w = row.clientWidth || 0;
        if (w !== lastWidth) render();
      }
      if (typeof ResizeObserver !== 'undefined') {
        new ResizeObserver(renderIfResized).observe(row);
      }
      window.addEventListener('resize', renderIfResized);
      if (window.requestAnimationFrame) window.requestAnimationFrame(renderIfResized);

      if (typeof subscribe === 'function' && typeof PUB_SUB_EVENTS !== 'undefined' && PUB_SUB_EVENTS.variantChange) {
        subscribe(PUB_SUB_EVENTS.variantChange, function (event) {
          var variant = event && event.data && event.data.variant;
          if (!variant || charactersIndex < 0) return;
          var next = budgetFrom(variant.options[charactersIndex]);
          if (next === budget) return;
          budget = next;
          if (tokens.length > budget) tokens = tokens.slice(0, budget);
          render();
        });
      }

      // The product form carries `novalidate`; enforce required-ness on the add
      // to cart click, before the AJAX submit handler runs.
      document.addEventListener(
        'click',
        function (evt) {
          var button = evt.target && evt.target.closest && evt.target.closest('button[type="submit"], button[name="add"]');
          if (!button) return;
          var form = button.form || button.closest('form');
          if (!form || form.getAttribute('id') !== {{ product_form_id | json }}) return;
          if (root.isConnected === false) return;

          var selects = root.querySelectorAll('select[required]');
          for (var i = 0; i < selects.length; i++) {
            if (selects[i].disabled || selects[i].checkValidity()) continue;
            evt.preventDefault();
            evt.stopImmediatePropagation();
            if (selects[i].closest('[data-custom-colors]')) {
              showError('Pick a color for the case, the keycap, and the letter.');
            }
            selects[i].reportValidity();
            return;
          }

          if (!tokens.length) {
            evt.preventDefault();
            evt.stopImmediatePropagation();
            showError('Add at least one letter, number, or symbol to your clicker.');
            if (root.scrollIntoView) root.scrollIntoView({ behavior: 'smooth', block: 'center' });
            typebox.focus({ preventScroll: true });
          }
        },
        true
      );

      syncCustom();
      render();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    })();
  </script>
{%- endif -%}
